# QA-2015: Verify work order open with permutations of Part Serial Number and Workcell settings.
import logging
import os
import sys
import time

sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..")))
import pytest
from playwright.sync_api import Page, expect

from e2e_tests_py.pages.choose_session_page import ChooseSessionPage
from e2e_tests_py.pages.choose_work_order_page import ChooseWorkOrderPage
from e2e_tests_py.pages.work_order_steps_page import WorkOrderStepsPage
from e2e_tests_py.service.config_utils import (
    WorkcellState,
    set_enable_part_serial_numbers,
    set_enable_workcells,
)
from e2e_tests_py.service.service_utils import disconnect_all_client_api, get_clients
from e2e_tests_py.service.start_stop_restart_services import restart_services

part_serial_number_state = [True, False]
workcell_state = [WorkcellState.isEnabled, WorkcellState.isDisabled]
part_serial_number = ["01", "InVALID*PSN", None]
workcell_name = ["VPS", None]
work_order_name = "AA_LT5_1"

# Build permutations, filtering out redundant cases at collection time so that
# expensive per-test fixtures (service restart, client connection) are not wasted.
permutations = [
    (serial_enabled, workcell_enabled, part_serial_input, workcell_input)
    for serial_enabled in part_serial_number_state
    for workcell_enabled in workcell_state
    for part_serial_input in part_serial_number
    for workcell_input in workcell_name
    # When workcells are disabled the workcell_input is irrelevant; keep only None
    if not (workcell_enabled == WorkcellState.isDisabled and workcell_input is not None)
    # When PSN is disabled the part_serial_input is irrelevant; keep only None
    if not (serial_enabled is False and part_serial_input is not None)
    # Clearing workcell XML entries does not reliably hide the workcell
    # selector when PSN is enabled; skip those combos and replace below.
    if not (serial_enabled is True and workcell_enabled == WorkcellState.isDisabled)
]

permutations += [
    (
        True,
        WorkcellState.isEnabled,
        "PART_02",
        "VPS",
    ),  # alphanumeric PSN, workcell selected
    (
        True,
        WorkcellState.isEnabled,
        "PART_02",
        None,
    ),  # alphanumeric PSN, no workcell → error
    (True, WorkcellState.isEnabled, "99", "VPS"),  # numeric-only PSN, workcell selected
]


